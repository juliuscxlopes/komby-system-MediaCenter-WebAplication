# URL base para as chamadas de API
# [AJUSTE] Apontava direto pra porta crua do DataCenter em HTTP/WS puro --
# como o app só é servido via nginx em HTTPS agora (Infra/nginx), uma página
# https:// chamando http:// é bloqueado pelo navegador como mixed content
# (a requisição nem chega a sair, não é nem erro de CORS). nginx já expõe os
# caminhos certos (/api e /ws, ambos atrás do TLS dele).
VITE_API_URL=https://localhost/api
VITE_CORE_WS_URL=ws://localhost:3000
VITE_DATACENTER_WS_URL=wss://localhost/ws
VITE_ANALYTICS_WS_URL=ws://localhost:3001

# Nome da aplicação (opcional, útil para o título da página ou logs)
VITE_APP_NAME="Web Appliance"

# Versão do sistema
VITE_APP_VERSION=1.0.0




# Redis
REDIS_HOST=kombi-redis
REDIS_PORT=6379
REDIS_PASSWORD=kombsystemRedis
